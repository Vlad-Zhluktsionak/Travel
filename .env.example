# --- Core ---
# Public URL of the app (used in sign-in links and alert emails)
APP_URL=http://localhost:3000
# Random string used to sign session cookies (openssl rand -hex 32)
SESSION_SECRET=change-me
# Only these emails can sign in (comma-separated). Required when deployed.
ALLOWED_EMAILS=you@gmail.com

# --- Database ---
# Local file by default. For Turso: DATABASE_URL=libsql://<db>-<org>.turso.io and DATABASE_AUTH_TOKEN=...
DATABASE_URL=file:./data/farewatch.db
DATABASE_AUTH_TOKEN=

# --- AI parsing (Claude) ---
ANTHROPIC_API_KEY=

# --- Prices (simulated when unset) ---
# Hotels: official-site prices from Google Hotels via SerpApi
SERPAPI_API_KEY=
# Flights: Duffel
DUFFEL_ACCESS_TOKEN=
# Minimum hours between scheduled re-checks (the scheduler runs every 6 h; hotels are slower to stay in SerpApi's free quota)
FLIGHT_CHECK_INTERVAL_HOURS=5
HOTEL_CHECK_INTERVAL_HOURS=11

# --- Email (Resend). Without a key, emails are printed to the server log.
RESEND_API_KEY=
EMAIL_FROM="FareWatch <onboarding@resend.dev>"

# --- Gmail Apps Script / inbound webhook ---
# Shared secret the Apps Script sends to /api/inbound-email (openssl rand -hex 16)
INBOUND_SECRET=change-me-too
# Optional: a forwarding address domain if you also set up an inbound email service
INBOUND_DOMAIN=

# --- Scheduler: GitHub Actions sends this as a Bearer token to /api/cron/check-prices
CRON_SECRET=

# --- Optional direct mailbox connections (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
