# --- Core ---
# Public URL of the app (used in magic links, OAuth redirects and alert emails)
APP_URL=http://localhost:3000
# Random string used to sign session cookies and OAuth state (openssl rand -hex 32)
SESSION_SECRET=change-me
# SQLite file location
DATABASE_PATH=./data/farewatch.db

# --- AI parsing (Claude) ---
ANTHROPIC_API_KEY=

# --- Flight prices ---
# "duffel" for live fares, "mock" for simulated demo prices (default when no Duffel token is set)
PRICE_PROVIDER=
DUFFEL_ACCESS_TOKEN=

# --- Outbound email (alerts + sign-in links) via Resend. Without a key, emails are logged to the console.
RESEND_API_KEY=
EMAIL_FROM="FareWatch <alerts@example.com>"

# --- Inbound email (forwarding) ---
# Route inbound mail for this domain to /api/inbound-email?secret=INBOUND_SECRET
# (Postmark, SendGrid Inbound Parse and Mailgun Routes payloads are supported)
INBOUND_DOMAIN=in.example.com
INBOUND_SECRET=change-me-too

# --- Mailbox connections (OAuth) ---
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=

# --- Scheduler ---
# Bearer token required by /api/cron/check-prices (Vercel Cron sends it automatically)
CRON_SECRET=
